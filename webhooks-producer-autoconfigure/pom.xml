<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.jinternals</groupId>
        <artifactId>webhooks</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>webhooks-producer-autoconfigure</artifactId>
    <name>webhooks-producer-autoconfigure</name>
    <description>Standard Webhooks producer auto-configuration — annotation-driven @WebhookClient publishing (no storage/retry). Add webhooks-producer-starter instead of depending on this directly.</description>

    <properties>
        <automatic.module.name>com.jinternals.webhooks.producer.autoconfigure</automatic.module.name>
    </properties>

    <dependencies>
        <!-- Shared wire model, @WebhookType, redactor, secret SPI (version managed by parent pom). -->
        <dependency>
            <groupId>io.github.jinternals</groupId>
            <artifactId>webhooks-core</artifactId>
        </dependency>

        <!-- RestClient + Jackson 3 for @WebhookClient delivery. The producer is a client only: it POSTs
             outbound and never serves HTTP, so it uses spring-boot-starter-restclient rather than
             spring-boot-starter-webmvc (avoiding spring-webmvc and embedded Tomcat while pulling in
             spring-boot-starter-jackson and spring-boot-restclient for out-of-the-box java.time, Optional,
             and Java record serialization). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>

        <!-- Auto-configuration + @ConfigurationProperties support. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- Official Standard Webhooks library (signing). -->
        <dependency>
            <groupId>com.standardwebhooks</groupId>
            <artifactId>standardwebhooks</artifactId>
        </dependency>

        <!-- Bean Validation (Hibernate Validator) so @Validated on WebhookProducerProperties rejects
             invalid configuration (null timeouts, …) at bind time with a clear message (SPEC §19). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Observability (see §13). The Micrometer Observation API backs @Observed on the publisher; the
             host app's actuator auto-wires a real ObservationRegistry (metrics via its MeterRegistry,
             traces if a tracer bridge is present). Without actuator this degrades to ObservationRegistry.NOOP. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-observation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>

        <!-- Generates configuration metadata for webhooks.producer.* properties. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                        <path>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-configuration-processor</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!--
              JaCoCo line+branch 100% gate. Excluded from the ratio (reason per entry):
                - annotations/*   annotation types (no executable code).
              Everything else — including the auto-config wiring, the @Data properties, and the
              @WebhookClient registrar/factory-bean/validation — is covered to 100% line+branch.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>com/jinternals/webhooks/producer/annotations/**</exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- PITest 100% mutation gate over the WHOLE module — nothing is excluded from mutation. -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <configuration>
                    <targetClasses>
                        <param>com.jinternals.webhooks.producer.*</param>
                    </targetClasses>
                    <targetTests>
                        <param>com.jinternals.webhooks.producer.*</param>
                    </targetTests>
                    <outputFormats>
                        <param>HTML</param>
                        <param>XML</param>
                    </outputFormats>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
