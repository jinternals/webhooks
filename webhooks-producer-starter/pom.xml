<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.jinternals</groupId>
        <artifactId>webhooks</artifactId>
        <version>1.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>webhooks-producer-starter</artifactId>
    <name>webhooks-producer-starter</name>
    <description>Starter for the Standard Webhooks producer: add this one dependency to sign and send webhooks via @WebhookClient.</description>

    <properties>
        <automatic.module.name>com.jinternals.webhooks.producer.starter</automatic.module.name>
        <maven.source.skip>true</maven.source.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
    </properties>

    <!--
      Thin starter (the canonical Spring Boot pattern): it carries no code of its own. Adding it to a
      Spring Boot app pulls in the producer auto-configuration and every runtime dependency the sender
      needs (Spring web/RestClient, the Standard Webhooks signer, Micrometer, …) transitively via
      webhooks-producer-autoconfigure. A host app adds ONLY this dependency.
    -->
    <dependencies>
        <dependency>
            <groupId>io.github.jinternals</groupId>
            <artifactId>webhooks-producer-autoconfigure</artifactId>
        </dependency>
    </dependencies>

    <!--
      Maven Central requires -sources and -javadoc jars for every jar artifact. This starter has no code, so
      the `release` profile attaches placeholder jars containing only this module's README.md.
    -->
    <profiles>
        <profile>
            <id>snapshot</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>placeholder-sources</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                                <configuration>
                                    <classifier>sources</classifier>
                                    <classesDirectory>${project.basedir}</classesDirectory>
                                    <includes>
                                        <include>README.md</include>
                                    </includes>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>placeholder-sources</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                                <configuration>
                                    <classifier>sources</classifier>
                                    <classesDirectory>${project.basedir}</classesDirectory>
                                    <includes>
                                        <include>README.md</include>
                                    </includes>
                                </configuration>
                            </execution>
                            <execution>
                                <id>placeholder-javadoc</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                                <configuration>
                                    <classifier>javadoc</classifier>
                                    <classesDirectory>${project.basedir}</classesDirectory>
                                    <includes>
                                        <include>README.md</include>
                                    </includes>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
