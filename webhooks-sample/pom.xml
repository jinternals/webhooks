<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Parent + aggregator for the two STANDALONE sample apps (producer + consumer). This reactor is
      deliberately separate from the libraries' webhooks-parent: the samples depend on the PUBLISHED
      webhooks-* artifacts, not on sibling modules. Build/install the libraries first, then build here:

          (repo root) mvn -pl webhooks-consumer-starter,webhooks-producer-starter -am install
          (webhooks-sample/)   mvn install

      Or use Docker (see docker-compose.yml + integration-test.sh in this directory).
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>io.github.jinternals.webhooks.sample</groupId>
    <artifactId>webhooks-sample</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>webhooks-sample</name>
    <description>Standalone sample apps for the webhooks toolkit: one producer, one consumer</description>

    <modules>
        <module>producer-sample</module>
        <module>consumer-sample</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <!-- Version of the published webhooks-* libraries the samples consume. -->
        <webhooks.version>0.1.0-SNAPSHOT</webhooks.version>
        <!-- Code formatting, matching the libraries' house style (Palantir Java Format: 4-space, 120-col). -->
        <spotless.version>3.11.0</spotless.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.jinternals</groupId>
                <artifactId>webhooks-consumer-starter</artifactId>
                <version>${webhooks.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.jinternals</groupId>
                <artifactId>webhooks-producer-starter</artifactId>
                <version>${webhooks.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Lombok annotation processor wiring, shared by both sample apps. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>

                <!--
                  Spotless code formatting (Palantir Java Format: 4-space, 120-column), matching the
                  libraries. Drive with `mvn spotless:check` / `mvn spotless:apply`.
                -->
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>${spotless.version}</version>
                    <configuration>
                        <java>
                            <includes>
                                <include>src/main/java/**/*.java</include>
                                <include>src/test/java/**/*.java</include>
                            </includes>
                            <palantirJavaFormat/>
                            <removeUnusedImports/>
                            <trimTrailingWhitespace/>
                            <endWithNewline/>
                        </java>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
