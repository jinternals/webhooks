<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
         child.project.url.inherit.append.path="false">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.jinternals</groupId>
    <artifactId>webhooks</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>webhooks</name>
    <description>Standard Webhooks for Spring Boot — shared core + consumer + producer (no storage)</description>
    <!--
      Project metadata required by Maven Central. Rather than inheriting spring-boot-starter-parent (which is
      designed for runnable applications), this library parent imports spring-boot-dependencies as a BOM below.
      The child.*.inherit.append.path="false" attributes stop Maven appending each module's artifactId to URLs.
    -->
    <url>https://github.com/jinternals/webhooks</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>pandeymradul</id>
            <name>Mradul Pandey</name>
            <email>pandeymradul@gmail.com</email>
            <url>https://github.com/jinternals</url>
        </developer>
    </developers>

    <scm child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false"
         child.scm.url.inherit.append.path="false">
        <connection>scm:git:https://github.com/jinternals/webhooks.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/jinternals/webhooks.git</developerConnection>
        <url>https://github.com/jinternals/webhooks</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/jinternals/webhooks/issues</url>
    </issueManagement>

    <modules>
        <module>webhooks-core</module>
        <module>webhooks-consumer-autoconfigure</module>
        <module>webhooks-consumer-starter</module>
        <module>webhooks-producer-autoconfigure</module>
        <module>webhooks-producer-starter</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>

        <spring-boot.version>4.2.0</spring-boot.version>
        <standardwebhooks.version>1.3.0</standardwebhooks.version>

        <!-- Standard Maven lifecycle plugins (explicit since we import spring-boot-dependencies BOM rather than spring-boot-starter-parent). -->
        <maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>
        <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.6.1</maven-surefire-plugin.version>
        <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
        <maven-install-plugin.version>3.2.0</maven-install-plugin.version>
        <maven-deploy-plugin.version>3.2.0</maven-deploy-plugin.version>

        <!-- Quality gate tooling (see SPEC.md §16). -->
        <jacoco.version>0.8.16</jacoco.version>
        <pitest.version>1.30.2</pitest.version>
        <pitest-junit5.version>1.2.3</pitest-junit5.version>
        <pitest.threads>4</pitest.threads>
        <!-- Mutation testing is slow (~4 min), so the local `mvn verify` skips it by default and keeps only the
             100% JaCoCo gate. Enable with the `mutation` profile (`mvn -Pmutation verify`); CI always does. -->
        <skipPitest>true</skipPitest>

        <!-- Code formatting (Spotless + Palantir Java Format: 4-space, 120-col — matches the house style). -->
        <spotless.version>3.12.0</spotless.version>

        <!-- Dependency vulnerability scanning (OWASP dependency-check; see SPEC.md §16, §19e). Opt-in via
             the `security-scan` profile — a full NVD scan is slow and network-bound, so it is kept off the
             default `verify`. -->
        <dependency-check.version>13.0.0</dependency-check.version>

        <!-- Release / Maven Central publishing (used only by the `release` profile). -->
        <maven-source-plugin.version>3.4.0</maven-source-plugin.version>
        <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>
        <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
        <central-publishing-plugin.version>0.12.0</central-publishing-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.github.jinternals</groupId>
                <artifactId>webhooks-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.jinternals</groupId>
                <artifactId>webhooks-consumer-autoconfigure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.jinternals</groupId>
                <artifactId>webhooks-consumer-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.jinternals</groupId>
                <artifactId>webhooks-producer-autoconfigure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.jinternals</groupId>
                <artifactId>webhooks-producer-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.standardwebhooks</groupId>
                <artifactId>standardwebhooks</artifactId>
                <version>${standardwebhooks.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>${maven-clean-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven-resources-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${java.version}</release>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                    <configuration>
                        <archive>
                            <manifestEntries>
                                <Automatic-Module-Name>${automatic.module.name}</Automatic-Module-Name>
                            </manifestEntries>
                        </archive>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>${maven-install-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>${maven-deploy-plugin.version}</version>
                </plugin>

                <!--
                  JaCoCo: 100% line + branch coverage, enforced. `check` is bound to `verify` and
                  fails the build below 100%. Classes that cannot be meaningfully unit-tested are
                  excluded explicitly (with a reason) rather than lowering the ratio — see each
                  module's <excludes>.
                -->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                    <executions>
                        <execution>
                            <id>jacoco-prepare</id>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>jacoco-report</id>
                            <phase>test</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>jacoco-check</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                            <configuration>
                                <rules>
                                    <rule>
                                        <element>BUNDLE</element>
                                        <limits>
                                            <limit>
                                                <counter>LINE</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>1.00</minimum>
                                            </limit>
                                            <limit>
                                                <counter>BRANCH</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>1.00</minimum>
                                            </limit>
                                        </limits>
                                    </rule>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>

                <!--
                  PITest mutation testing: 100% mutation + test-strength, enforced. `mutationCoverage` is bound to
                  `verify` but skipped unless the `mutation` profile is active (see `skipPitest` above):
                    mvn -Pmutation verify                       (whole reactor — what CI runs)
                    mvn -Pmutation -pl <module> -am verify      (one module)
                -->
                <plugin>
                    <groupId>org.pitest</groupId>
                    <artifactId>pitest-maven</artifactId>
                    <version>${pitest.version}</version>
                    <dependencies>
                        <dependency>
                            <groupId>org.pitest</groupId>
                            <artifactId>pitest-junit5-plugin</artifactId>
                            <version>${pitest-junit5.version}</version>
                        </dependency>
                    </dependencies>
                    <configuration>
                        <threads>${pitest.threads}</threads>
                        <mutationThreshold>100</mutationThreshold>
                        <coverageThreshold>100</coverageThreshold>
                        <mutators>
                            <mutator>STRONGER</mutator>
                        </mutators>
                        <timestampedReports>false</timestampedReports>
                        <!--
                          Under PITest instrumentation the @SpringBootTest context tests run far slower than
                          their un-instrumented wall-clock, and an infinite-loop mutation (e.g. a mutated
                          backoff loop) must be given room to be detected as TIMED_OUT rather than aborting
                          the minion mid-run — a minion abort silently drops coverage data and shows up as
                          spurious "no coverage" survivors. These generous timeouts keep the run stable.
                        -->
                        <timeoutConstant>15000</timeoutConstant>
                        <timeoutFactor>2.5</timeoutFactor>
                    </configuration>
                    <executions>
                        <execution>
                            <id>pitest-mutation-check</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>mutationCoverage</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!--
                  Spotless code formatting with Palantir Java Format (4-space indent, 120-column — the
                  house style). Also removes unused imports, trims trailing whitespace, and enforces a
                  trailing newline. Not bound to the default build; drive it with:
                    mvn spotless:check   (report violations, no changes — also runs via the `format` profile)
                    mvn spotless:apply   (reformat in place)
                -->
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>${spotless.version}</version>
                    <configuration>
                        <java>
                            <includes>
                                <include>src/main/java/**/*.java</include>
                                <include>src/test/java/**/*.java</include>
                            </includes>
                            <palantirJavaFormat/>
                            <removeUnusedImports/>
                            <trimTrailingWhitespace/>
                            <endWithNewline/>
                        </java>
                    </configuration>
                </plugin>

                <!--
                  OWASP dependency-check: flags dependencies with known CVEs (see SPEC.md §19e). Opt-in
                  via the `security-scan` profile (below) rather than bound to `verify`, because a full NVD
                  scan is slow and network-bound. The build fails on a CVSS >= 7 (high/critical) finding.
                -->
                <plugin>
                    <groupId>org.owasp</groupId>
                    <artifactId>dependency-check-maven</artifactId>
                    <version>${dependency-check.version}</version>
                    <configuration>
                        <!-- Fail the build on a high/critical finding (CVSS 7.0+). -->
                        <failBuildOnCVSS>7</failBuildOnCVSS>
                        <!-- NVD API key read from the NVD_API_KEY env var (never pass it as -D: it leaks into logs). -->
                        <nvdApiKeyEnvironmentVariable>NVD_API_KEY</nvdApiKeyEnvironmentVariable>
                        <!-- Scan only compile/runtime deps that actually ship. -->
                        <skipTestScope>true</skipTestScope>
                        <skipProvidedScope>true</skipProvidedScope>
                    </configuration>
                    <executions>
                        <execution>
                            <id>owasp-dependency-check</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- Release / Maven Central publishing plugins (activated by the `release` profile). -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>${maven-source-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>${maven-javadoc-plugin.version}</version>
                    <configuration>
                        <!-- Don't fail a release on missing @param/@return tags; real errors still fail. -->
                        <doclint>all,-missing</doclint>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-gpg-plugin</artifactId>
                    <version>${maven-gpg-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.sonatype.central</groupId>
                    <artifactId>central-publishing-maven-plugin</artifactId>
                    <version>${central-publishing-plugin.version}</version>
                    <configuration>
                        <publishingServerId>central</publishingServerId>
                        <autoPublish>false</autoPublish>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!--
          Mutation-testing gate: `mvn -Pmutation verify` runs PITest (100% mutation score required) on top of
          the always-on 100% JaCoCo coverage gate. CI runs this profile on every push and pull request.
        -->
        <profile>
            <id>mutation</id>
            <properties>
                <skipPitest>false</skipPitest>
            </properties>
        </profile>
        <!--
          Opt-in vulnerability scan: `mvn -Psecurity-scan verify`. Kept out of the default build so the
          100% coverage/mutation gate stays fast and offline; CI can run this profile on a schedule. An
          NVD API key (exported as the `NVD_API_KEY` environment variable) is recommended to avoid download throttling.
        -->
        <profile>
            <id>security-scan</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
          Opt-in formatting gate: `mvn -Pformat verify` fails the build on any Spotless violation.
          Kept off the default build; run `mvn spotless:apply` to auto-fix.
        -->
        <profile>
            <id>format</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.diffplug.spotless</groupId>
                        <artifactId>spotless-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>spotless-check</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
          Maven Central release: `mvn -Prelease clean deploy`.
          Attaches -sources and -javadoc jars, GPG-signs every artifact, and uploads the bundle to the Central
          Portal (https://central.sonatype.com). Prerequisites:
            1. The `io.github.jinternals` namespace verified on the Central Portal.
            2. A Portal user token in ~/.m2/settings.xml as <server><id>central</id>…</server>.
            3. A GPG key whose public half is published to a keyserver (keys.openpgp.org).
          autoPublish is false: the upload is validated and staged, then you press "Publish" in the Portal.
          The thin starters carry no code, so they attach small placeholder sources/javadoc jars (see their poms).
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <extensions>true</extensions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
