<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.jinternals</groupId>
    <artifactId>webhooks-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>webhooks-parent</name>
    <description>Standard Webhooks for Spring Boot — shared core + consumer + producer (no storage)</description>

    <modules>
        <module>webhooks-core</module>
        <module>webhooks-consumer-autoconfigure</module>
        <module>webhooks-consumer-starter</module>
        <module>webhooks-producer-autoconfigure</module>
        <module>webhooks-producer-starter</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <standardwebhooks.version>1.2.0</standardwebhooks.version>
        <reflections.version>0.10.2</reflections.version>

        <!-- Quality gate tooling (see SPEC.md §16). -->
        <jacoco.version>0.8.12</jacoco.version>
        <pitest.version>1.17.0</pitest.version>
        <pitest-junit5.version>1.2.1</pitest-junit5.version>

        <!-- Code formatting (Spotless + Palantir Java Format: 4-space, 120-col — matches the house style). -->
        <spotless.version>2.44.5</spotless.version>

        <!-- Dependency vulnerability scanning (OWASP dependency-check; see SPEC.md §16, §19e). Opt-in via
             the `security-scan` profile — a full NVD scan is slow and network-bound, so it is kept off the
             default `verify`. -->
        <dependency-check.version>10.0.4</dependency-check.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.jinternals</groupId>
                <artifactId>webhooks-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jinternals</groupId>
                <artifactId>webhooks-consumer-autoconfigure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jinternals</groupId>
                <artifactId>webhooks-consumer-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jinternals</groupId>
                <artifactId>webhooks-producer-autoconfigure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jinternals</groupId>
                <artifactId>webhooks-producer-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.standardwebhooks</groupId>
                <artifactId>standardwebhooks</artifactId>
                <version>${standardwebhooks.version}</version>
            </dependency>
            <dependency>
                <groupId>org.reflections</groupId>
                <artifactId>reflections</artifactId>
                <version>${reflections.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!--
                  JaCoCo: 100% line + branch coverage, enforced. `check` is bound to `verify` and
                  fails the build below 100%. Classes that cannot be meaningfully unit-tested are
                  excluded explicitly (with a reason) rather than lowering the ratio — see each
                  module's <excludes>.
                -->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                    <executions>
                        <execution>
                            <id>jacoco-prepare</id>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>jacoco-report</id>
                            <phase>test</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>jacoco-check</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                            <configuration>
                                <rules>
                                    <rule>
                                        <element>BUNDLE</element>
                                        <limits>
                                            <limit>
                                                <counter>LINE</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>1.00</minimum>
                                            </limit>
                                            <limit>
                                                <counter>BRANCH</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>1.00</minimum>
                                            </limit>
                                        </limits>
                                    </rule>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>

                <!--
                  PITest mutation testing: 100% mutation + test-strength, enforced. `mutationCoverage`
                  is bound to `verify` and fails the build below 100%. Run on demand with
                  `mvn -pl <module> test-compile org.pitest:pitest-maven:mutationCoverage`.
                -->
                <plugin>
                    <groupId>org.pitest</groupId>
                    <artifactId>pitest-maven</artifactId>
                    <version>${pitest.version}</version>
                    <dependencies>
                        <dependency>
                            <groupId>org.pitest</groupId>
                            <artifactId>pitest-junit5-plugin</artifactId>
                            <version>${pitest-junit5.version}</version>
                        </dependency>
                    </dependencies>
                    <configuration>
                        <mutationThreshold>100</mutationThreshold>
                        <coverageThreshold>100</coverageThreshold>
                        <mutators>
                            <mutator>STRONGER</mutator>
                        </mutators>
                        <timestampedReports>false</timestampedReports>
                        <!--
                          Under PITest instrumentation the @SpringBootTest context tests run far slower than
                          their un-instrumented wall-clock, and an infinite-loop mutation (e.g. a mutated
                          backoff loop) must be given room to be detected as TIMED_OUT rather than aborting
                          the minion mid-run — a minion abort silently drops coverage data and shows up as
                          spurious "no coverage" survivors. These generous timeouts keep the run stable.
                        -->
                        <timeoutConstant>15000</timeoutConstant>
                        <timeoutFactor>2.5</timeoutFactor>
                    </configuration>
                    <executions>
                        <execution>
                            <id>pitest-mutation-check</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>mutationCoverage</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!--
                  Spotless code formatting with Palantir Java Format (4-space indent, 120-column — the
                  house style). Also removes unused imports, trims trailing whitespace, and enforces a
                  trailing newline. Not bound to the default build; drive it with:
                    mvn spotless:check   (report violations, no changes — also runs via the `format` profile)
                    mvn spotless:apply   (reformat in place)
                -->
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>${spotless.version}</version>
                    <configuration>
                        <java>
                            <includes>
                                <include>src/main/java/**/*.java</include>
                                <include>src/test/java/**/*.java</include>
                            </includes>
                            <palantirJavaFormat/>
                            <removeUnusedImports/>
                            <trimTrailingWhitespace/>
                            <endWithNewline/>
                        </java>
                    </configuration>
                </plugin>

                <!--
                  OWASP dependency-check: flags dependencies with known CVEs (see SPEC.md §19e). Opt-in
                  via the `security-scan` profile (below) rather than bound to `verify`, because a full NVD
                  scan is slow and network-bound. The build fails on a CVSS >= 7 (high/critical) finding.
                -->
                <plugin>
                    <groupId>org.owasp</groupId>
                    <artifactId>dependency-check-maven</artifactId>
                    <version>${dependency-check.version}</version>
                    <configuration>
                        <!-- Fail the build on a high/critical finding (CVSS 7.0+). -->
                        <failBuildOnCVSS>7</failBuildOnCVSS>
                        <!-- Scan only compile/runtime deps that actually ship. -->
                        <skipTestScope>true</skipTestScope>
                        <skipProvidedScope>true</skipProvidedScope>
                    </configuration>
                    <executions>
                        <execution>
                            <id>owasp-dependency-check</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!--
          Opt-in vulnerability scan: `mvn -Psecurity-scan verify`. Kept out of the default build so the
          100% coverage/mutation gate stays fast and offline; CI can run this profile on a schedule. An
          NVD API key (`-Dnvd.api.key=...`) is recommended to avoid download throttling.
        -->
        <profile>
            <id>security-scan</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
          Opt-in formatting gate: `mvn -Pformat verify` fails the build on any Spotless violation.
          Kept off the default build; run `mvn spotless:apply` to auto-fix.
        -->
        <profile>
            <id>format</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.diffplug.spotless</groupId>
                        <artifactId>spotless-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>spotless-check</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
